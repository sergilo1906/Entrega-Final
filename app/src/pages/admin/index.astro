---
import DisenoPrincipal from "../../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Administració">
  <section class="max-w-4xl mx-auto space-y-4">
    <header class="bg-white border rounded p-4 space-y-1">
      <h1 class="text-xl font-semibold">Administració</h1>
      <p class="text-sm text-gray-600">Les eines per gestionar la barberia: agenda, serveis, horari i dies tancats.</p>
    </header>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/agenda" class="bg-white border rounded p-4 hover:bg-gray-50">
        <h2 class="font-medium text-sm">Agenda</h2>
        <p class="text-xs text-gray-600 mt-1">Consulta les cites del dia i marca els serveis completats.</p>
      </a>

      <a href="/horarios" class="bg-white border rounded p-4 hover:bg-gray-50">
        <h2 class="font-medium text-sm">Horari</h2>
        <p class="text-xs text-gray-600 mt-1">Defineix l’horari habitual i tanca dates completes.</p>
      </a>

      <a href="/servicios" class="bg-white border rounded p-4 hover:bg-gray-50">
        <h2 class="font-medium text-sm">Serveis</h2>
        <p class="text-xs text-gray-600 mt-1">Edita el nom, la durada, el preu i la disponibilitat dels serveis.</p>
      </a>
    </div>
  </section>
</DisenoPrincipal>

