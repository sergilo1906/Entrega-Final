---
// Pàgina que mostrem quan una adreça no existeix.
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal title="Pàgina no trobada">
  <section class="max-w-xl mx-auto rounded-lg border border-gray-200 bg-white p-8 text-center space-y-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">404</p>
    <h1 class="text-2xl font-semibold text-gray-900">Aquesta pàgina no existeix o ja no està disponible.</h1>
    <p class="text-sm text-gray-600">
      Torna a l’inici o entra a la secció que necessitis per continuar amb la reserva o la gestió.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded border px-4 py-2 text-sm hover:bg-gray-50">Torna a l’inici</a>
      <a href="/reservar" class="rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Reserva una cita</a>
    </div>
  </section>
</DisenoPrincipal>
