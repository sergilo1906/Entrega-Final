---
// Contacte, verificació del correu i botons per guardar o sortir del compte.
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal title="El meu perfil" noindex>
  <section data-perfil-root class="max-w-2xl bg-white p-5 rounded shadow space-y-5 mx-auto">
    <header class="space-y-1">
      <h1 class="text-xl font-semibold">El meu perfil</h1>
      <p class="text-sm text-gray-600">Actualitza les dades de contacte i comprova l’estat del compte.</p>
    </header>

    <div class="rounded border border-gray-200 bg-gray-50 p-3 text-sm space-y-2">
      <p><strong>Correu electrònic:</strong> <span id="perfil-email"></span></p>
      <p>
        <strong>Estat del correu:</strong>{" "}
        <span id="perfil-verif" class="inline-block rounded px-2 py-0.5 text-xs font-medium"></span>
      </p>
      <!-- Aquest botó només es mostra si encara falta verificar el correu. -->
      <button id="perfil-send-verify" class="text-xs underline text-blue-600 hidden" type="button">Torna a enviar la verificació</button>
      <p class="text-xs text-gray-500">Tipus de compte: <span id="perfil-role" class="font-medium"></span></p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 text-sm">
      <label class="space-y-1">
        <span class="block text-xs text-gray-600">Nom</span>
        <input id="perfil-name" autocomplete="name" maxlength="100" class="w-full border rounded px-3 py-2 text-sm" placeholder="El teu nom" />
      </label>

      <label class="space-y-1">
        <span class="block text-xs text-gray-600">Telèfon</span>
        <!-- maxLength ajuda al formulari; la mateixa limitació també es comprova al codi i a les regles. -->
        <input id="perfil-phone" type="tel" autocomplete="tel" maxlength="30" class="w-full border rounded px-3 py-2 text-sm" placeholder="Opcional" />
      </label>
    </div>

    <div class="flex flex-col sm:flex-row gap-2">
      <button id="perfil-save" class="flex-1 bg-blue-600 text-white rounded py-2 font-medium hover:bg-blue-700 text-sm" type="button">Desa els canvis</button>
      <button id="perfil-logout" class="flex-1 bg-gray-800 text-white rounded py-2 font-medium hover:bg-black text-sm" type="button">Tanca la sessió</button>
    </div>

    <p id="perfil-msg" role="status" aria-live="polite" class="text-xs text-gray-600 min-h-[1.5rem] leading-tight"></p>
  </section>

  <script>import "../modulos/cuentas/editar-perfil";</script>
</DisenoPrincipal>
