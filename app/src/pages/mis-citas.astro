---
// Cites pròpies i filtres. El JavaScript les carrega després de comprovar la sessió.
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal title="Les meves cites" noindex>
  <section class="max-w-4xl mx-auto">
    <div class="bg-white p-4 rounded shadow flex flex-col space-y-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 class="font-semibold text-lg">Les meves cites</h1>
          <p class="text-xs text-gray-600">Revisa les teves cites i cancel·la les confirmades que encara no han començat.</p>
        </div>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="text-xs text-gray-600">Data
          <!-- La data filtra la llista pròpia; deixar-la buida permet tornar a veure totes les cites pròpies. -->
          <input id="filter-date" type="date" class="mt-1 w-full rounded border px-2 py-2 text-sm" />
        </label>
        <label class="text-xs text-gray-600">Estat
          <!-- Els value conserven els estats de Firebase encara que les etiquetes visibles estiguin en català. -->
          <select id="filter-status" class="mt-1 w-full rounded border px-2 py-2 text-sm">
            <option value="all">Totes</option>
            <option value="confirmed">Confirmada</option>
            <option value="done">Completada</option>
            <option value="cancelled">Cancel·lada</option>
          </select>
        </label>
      </div>
      <!-- Aquí es mostra tant l’espera de càrrega com el resultat buit dels filtres. -->
      <p id="my-msg" role="status" aria-live="polite" class="text-xs text-gray-600 min-h-[1.5rem] leading-tight"></p>
      <!-- El mòdul afegeix només les cites que pot consultar el compte actual. -->
      <div id="my-list" class="divide-y divide-gray-200 text-sm rounded border border-gray-200"></div>
    </div>
  </section>
  <script>import "../modulos/reservas/mis-citas";</script>
</DisenoPrincipal>

