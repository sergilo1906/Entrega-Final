---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal title="Agenda diària" noindex>
  <section class="max-w-4xl mx-auto">
    <div class="bg-white p-4 rounded shadow flex flex-col space-y-4">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 class="font-semibold text-lg">Agenda diària</h1>
          <p class="text-xs text-gray-600">Consulta les cites del dia, filtra-les i actualitza’n l’estat.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-gray-600">
          <label class="flex items-center gap-2">
            <span>Data</span>
            <input id="agenda-date" type="date" class="border rounded px-2 py-1 text-sm" />
          </label>
          <label class="flex items-center gap-2">
            <span>Estat</span>
            <select id="agenda-status" class="border rounded px-2 py-1 text-sm">
              <option value="all">Totes</option>
              <option value="confirmed">Confirmada</option>
              <option value="done">Completada</option>
              <option value="cancelled">Cancel·lada</option>
            </select>
          </label>
        </div>
      </div>

      <p id="agenda-msg" class="text-xs text-gray-600 min-h-[1.5rem] leading-tight"></p>

      <div id="agenda-list" class="divide-y divide-gray-200 text-sm rounded border border-gray-200"></div>
    </div>
  </section>

  <script>import "../modulos/administracion/agenda-diaria";</script>
</DisenoPrincipal>

