---
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal noindex title="Serveis">
  <section class="max-w-5xl mx-auto space-y-4">
    <div class="bg-white border rounded-lg p-4">
      <h1 class="text-2xl font-semibold mb-2">Serveis</h1>
      <p class="text-sm text-gray-600">Gestiona els serveis que veu el client quan reserva.</p>
    </div>

    <div class="bg-white border rounded-lg p-4">
      <h2 class="text-lg font-semibold mb-3">Crea un servei</h2>
      <form id="service-create-form" class="grid md:grid-cols-4 gap-3 text-sm">
        <label class="flex flex-col gap-1">
          <span class="text-xs text-gray-600">Nom</span>
          <input id="service-name" required class="border rounded px-3 py-2" placeholder="Tall clàssic" />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-xs text-gray-600">Durada (min)</span>
          <input id="service-duration" type="number" min="30" max="60" step="30" required class="border rounded px-3 py-2" value="30" />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-xs text-gray-600">Preu (EUR)</span>
          <input id="service-price" type="number" min="0" step="0.5" required class="border rounded px-3 py-2" value="15" />
        </label>
        <label class="flex items-center gap-2 mt-6">
          <input id="service-active" type="checkbox" checked class="rounded border-gray-300" />
          <span>Actiu</span>
        </label>
        <button class="md:col-span-4 bg-blue-600 text-white rounded px-4 py-2 text-sm font-medium hover:bg-blue-700" type="submit">Crea un servei</button>
      </form>
    </div>

    <div class="bg-white border rounded-lg p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-semibold">Llista de serveis</h2>
        <button id="services-refresh" class="text-sm border rounded px-3 py-1 hover:bg-gray-50">Recarrega</button>
      </div>
      <p id="services-msg" role="status" class="text-xs text-gray-600 mb-2"></p>
      <div id="services-list" class="space-y-3"></div>
    </div>
  </section>
  <script>import "../modulos/administracion/servicios";</script>
</DisenoPrincipal>

