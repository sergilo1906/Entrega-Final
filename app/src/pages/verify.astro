---
// Pantalla per mostrar el resultat de l’enllaç de verificació del correu.
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";
---

<DisenoPrincipal title="Verifica el correu" noindex>
  <section class="max-w-md bg-white p-4 rounded shadow mx-auto space-y-3 text-sm">
    <h1 class="font-semibold text-lg">Verifica el correu</h1>
    <!-- El text inicial es substituirà pel resultat de llegir el codi i consultar Authentication. -->
    <p id="verify-msg" role="status" aria-live="polite" class="text-sm text-gray-700">Processant l’enllaç de verificació…</p>
    <div class="flex gap-2 pt-2">
      <a href="/perfil" class="px-3 py-2 rounded border hover:bg-gray-50">Ves al perfil</a>
      <a href="/login" class="px-3 py-2 rounded bg-blue-600 text-white hover:bg-blue-700">Inicia sessió</a>
    </div>
  </section>

  <script>import "../modulos/cuentas/verificar-correo";</script>
</DisenoPrincipal>
