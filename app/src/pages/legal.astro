---
// Expliquem les dades que guarda la mostra i què es pot canviar des del perfil.
import DisenoPrincipal from "../layouts/DisenoPrincipal.astro";

const apartadosLegales = [
  {
    titulo: "Reserves i cancel·lacions",
    parrafos: [
      "Les reserves es confirmen amb l’horari i el professional assignat en crear la cita.",
      "El client pot cancel·lar una cita confirmada abans que comenci. Per canviar d’hora, cal cancel·lar-la i fer una reserva nova.",
    ],
  },
  {
    titulo: "Dades de contacte",
    parrafos: [
      "Es desen el nom, el correu i el telèfon per identificar el compte, localitzar reserves i mostrar l’agenda a l’administrador.",
      "L’usuari pot canviar el nom i el telèfon des de la pàgina de perfil. El correu identifica el compte i no es canvia des d’aquest formulari.",
    ],
  },
  {
    titulo: "Accessos interns",
    parrafos: [
      "Les pantalles d’agenda, horari, serveis i administració només estan disponibles per a l’administrador autoritzat.",
      "Si un compte canvia de tipus d’accés, pot caldre sortir i tornar a entrar.",
    ],
  },
];
---

<DisenoPrincipal title="Avís legal i política">
  <section class="max-w-4xl mx-auto space-y-4">
    <header class="bg-white border rounded-lg p-6 space-y-2">
      <h1 class="text-2xl font-semibold">Avís legal i política d’ús</h1>
      <p class="text-sm text-gray-600">
        Resum del funcionament de les reserves i de les dades desades. Aquesta és una demostració acadèmica amb dades fictícies, sense una barberia comercial al darrere.
      </p>
    </header>
    <section class="bg-white border rounded-lg p-6 space-y-4 text-sm text-gray-700">
      {
        apartadosLegales.map((apartado) => (
          <div>
            <h2 class="font-semibold text-gray-900">{apartado.titulo}</h2>
            {apartado.parrafos.map((parrafo) => <p>{parrafo}</p>)}
          </div>
        ))
      }
    </section>
  </section>
</DisenoPrincipal>

